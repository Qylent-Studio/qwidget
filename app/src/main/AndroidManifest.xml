<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <queries><package android:name="com.spotify.music" /></queries>
    <application android:name=".battery.QWidgetApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="false" android:supportsRtl="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".settings.WidgetSettingsActivity" android:exported="true" android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <activity android:name=".probe.ProbeActivity" android:exported="false" />
        <activity android:name=".probe.SpotifyPlayActivity" android:exported="false"
            android:excludeFromRecents="true" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity android:name=".automation.AutomationActivity" android:exported="true" android:theme="@android:style/Theme.Material.NoActionBar" />
        <receiver android:name=".spotify.widget.SpotifyCompactReceiver" android:exported="true" android:label="@string/spotify_compact">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/spotify_compact_info" />
        </receiver>
        <receiver android:name=".spotify.widget.SpotifyLargeReceiver" android:exported="true" android:label="@string/spotify_large">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/spotify_large_info" />
        </receiver>
        <receiver android:name=".battery.BatteryWidgetReceiver" android:exported="true" android:label="@string/battery_widget">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/battery_info" />
        </receiver>
        <service android:name=".probe.SpotifyListener" android:exported="false"
            android:label="QWidget Spotify takibi"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
        <receiver android:name=".probe.BluetoothReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED" />
                <action android:name="android.bluetooth.action.LE_AUDIO_CONNECTION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
